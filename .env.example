NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/student_marks
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional OpenAI-compatible provider for the resume analyzer. Keep the key
# server-side; never add it to frontend code or commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
